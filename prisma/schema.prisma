// Prisma schema: https://pris.ly/d/prisma-schema
// The database URL is read from DATABASE_URL in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  title         String
  /// Product photos, e.g. one per colour. The first is the main image.
  images        String[]
  price         Decimal  @db.Decimal(12, 2)
  /// Price before discount. When set, the card shows a discount badge.
  originalPrice Decimal? @db.Decimal(12, 2)
  /// Average rating out of 5.
  rating        Decimal  @default(0) @db.Decimal(3, 2)
  numReviews    Int      @default(0)
  /// Units available. 0 means out of stock.
  stock         Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @updatedAt

  reviews Review[]

  @@index([createdAt])
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  author    String
  content   String
  /// Rating out of 5; half stars allowed (e.g. 4.5).
  rating    Decimal  @db.Decimal(2, 1)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model DressStyle {
  id    String @id @default(uuid()) @db.Uuid
  title String
  slug  String @unique
  image String
}

model Brand {
  id     String @id @default(uuid()) @db.Uuid
  name   String @unique
  logo   String
  /// Intrinsic logo size, needed by next/image.
  width  Int
  height Int
}
